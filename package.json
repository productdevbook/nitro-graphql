{
  "name": "nitro-graphql",
  "type": "module",
  "version": "2.0.0-beta.4",
  "packageManager": "pnpm@10.19.0",
  "description": "GraphQL integration for Nitro",
  "license": "MIT",
  "sideEffects": false,
  "imports": {
    "#graphql/server": {
      "types": "./dist/graphql/server.d.ts",
      "import": "./dist/graphql/server.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./watcher": {
      "types": "./dist/watcher.d.ts",
      "import": "./dist/watcher.js"
    },
    "./client-watcher": {
      "types": "./dist/client-watcher.d.ts",
      "import": "./dist/client-watcher.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/define": {
      "types": "./dist/utils/define.d.ts",
      "import": "./dist/utils/define.js"
    },
    "./utils/apollo": {
      "types": "./dist/utils/apollo.d.ts",
      "import": "./dist/utils/apollo.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.js"
    },
    "./nuxt": {
      "types": "./dist/ecosystem/nuxt.d.ts",
      "import": "./dist/ecosystem/nuxt.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bumpp": "bumpp package.json",
    "release": "pnpm build && pnpm bumpp && pnpm publish --no-git-checks --access public",
    "playground:nitro": "cd playgrounds/nitro && pnpm install && pnpm dev",
    "playground:nuxt": "cd playgrounds/nuxt && pnpm install && pnpm dev",
    "playground:federation": "cd playgrounds/federation && pnpm install && pnpm dev",
    "docs:dev": "cd .docs && pnpm install && pnpm dev",
    "docs:build": "cd .docs && pnpm install && pnpm build",
    "docs:preview": "cd .docs && pnpm preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "@apollo/utils.withrequired": "^3.0.0",
    "@as-integrations/h3": "^2.0.0",
    "graphql": "^16.11.0",
    "h3": "^2.0.1-rc.2",
    "nitro": "^3.0.1-alpha.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "@apollo/utils.withrequired": {
      "optional": true
    },
    "@as-integrations/h3": {
      "optional": true
    }
  },
  "dependencies": {
    "@apollo/subgraph": "catalog:",
    "@graphql-codegen/core": "catalog:",
    "@graphql-codegen/import-types-preset": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-resolvers": "catalog:",
    "@graphql-tools/graphql-file-loader": "catalog:",
    "@graphql-tools/load": "catalog:",
    "@graphql-tools/load-files": "catalog:",
    "@graphql-tools/merge": "catalog:",
    "@graphql-tools/schema": "catalog:",
    "@graphql-tools/url-loader": "catalog:",
    "@graphql-tools/utils": "catalog:",
    "chokidar": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "graphql-config": "catalog:",
    "graphql-scalars": "catalog:",
    "knitwork": "catalog:",
    "ohash": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "changelogen": "catalog:",
    "crossws": "catalog:",
    "eslint": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "h3": "catalog:",
    "nitro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitepress-plugin-llms": "^1.8.1"
  },
  "resolutions": {
    "nitro-graphql": "link:."
  }
}
