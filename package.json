{
  "name": "nitro-graphql",
  "type": "module",
  "version": "2.0.0-beta.43",
  "packageManager": "pnpm@10.27.0",
  "description": "GraphQL integration for Nitro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/productdevbook/nitro-graphql"
  },
  "sideEffects": false,
  "imports": {
    "#graphql/server": {
      "types": "./dist/stubs/index.d.mts",
      "import": "./dist/stubs/index.mjs"
    },
    "#nitro-graphql/graphql-config": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-schemas": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-resolvers": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-directives": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/module-config": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/debug-info": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.mts",
      "import": "./dist/cli/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./define": {
      "types": "./dist/define.d.mts",
      "import": "./dist/define.mjs"
    },
    "./apollo": {
      "types": "./dist/nitro/apollo.d.mts",
      "import": "./dist/nitro/apollo.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "nitro-graphql": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bumpp": "bumpp package.json",
    "release": "pnpm build && pnpm bumpp",
    "playground:nitro": "cd playgrounds/nitro && pnpm install && pnpm dev",
    "playground:nuxt": "cd playgrounds/nuxt && pnpm install && pnpm dev",
    "playground:federation": "cd playgrounds/federation && pnpm install && pnpm dev",
    "docs:dev": "cd .docs && pnpm install && pnpm update:metadata && pnpm dev",
    "docs:build": "cd .docs && pnpm install && pnpm update:metadata && pnpm build",
    "docs:preview": "cd .docs && pnpm preview",
    "cli": "node ./dist/cli/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "graphql": "^16.11.0",
    "nitro": "^3.0.1-alpha.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    }
  },
  "dependencies": {
    "@apollo/subgraph": "catalog:",
    "@bomb.sh/tab": "catalog:",
    "@graphql-codegen/core": "catalog:",
    "@graphql-codegen/import-types-preset": "catalog:",
    "@graphql-codegen/typed-document-node": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-resolvers": "catalog:",
    "@graphql-tools/graphql-file-loader": "catalog:",
    "@graphql-tools/load": "catalog:",
    "@graphql-tools/load-files": "catalog:",
    "@graphql-tools/merge": "catalog:",
    "@graphql-tools/schema": "catalog:",
    "@graphql-tools/url-loader": "catalog:",
    "@graphql-tools/utils": "catalog:",
    "c12": "catalog:",
    "chokidar": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "giget": "catalog:",
    "graphql-config": "catalog:",
    "graphql-scalars": "catalog:",
    "knitwork": "catalog:",
    "mlly": "catalog:",
    "ohash": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "perfect-debounce": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitest/ui": "catalog:",
    "bumpp": "catalog:",
    "changelogen": "catalog:",
    "crossws": "catalog:",
    "eslint": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "nitro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "nitro-graphql": "link:."
  }
}
