{
  "name": "nitro-graphql",
  "type": "module",
  "version": "0.0.4",
  "packageManager": "pnpm@10.13.1",
  "description": "GraphQL integration for Nitro",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.mts",
      "import": "./dist/codegen.mjs"
    },
    "./watcher": {
      "types": "./dist/watcher.d.mts",
      "import": "./dist/watcher.mjs"
    },
    "./client-watcher": {
      "types": "./dist/client-watcher.d.mts",
      "import": "./dist/client-watcher.mjs"
    },
    "./context": {
      "types": "./dist/context.d.mts",
      "import": "./dist/context.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./internal": {
      "types": "./dist/internal/index.d.mts",
      "import": "./dist/internal/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bumpp": "bumpp package.mjson",
    "release": "pnpm build && pnpm bumpp && pnpm publish --no-git-checks --access public",
    "playground": "cd playground && pnpm install && pnpm dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "nitropack": "^2.11.13"
  },
  "dependencies": {
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/plugin-helpers": "^5.1.1",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-generic-sdk": "^4.0.2",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@graphql-tools/graphql-file-loader": "^8.0.20",
    "@graphql-tools/load": "^8.1.0",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.0.24",
    "@graphql-tools/schema": "^10.0.23",
    "@graphql-tools/utils": "^10.8.6",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.15.1",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "perfect-debounce": "^1.0.0",
    "tinyglobby": "^0.2.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@types/node": "^20.19.7",
    "bumpp": "^10.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.31.0",
    "h3": "^1.15.3",
    "nitropack": "^2.11.13",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "nitro-graphql": "link:."
  }
}
