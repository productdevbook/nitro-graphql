{
  "name": "nitro-graphql",
  "type": "module",
  "version": "2.0.0-beta.71",
  "packageManager": "pnpm@10.31.0",
  "description": "GraphQL integration for Nitro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/productdevbook/nitro-graphql"
  },
  "sideEffects": false,
  "imports": {
    "#graphql/server": {
      "types": "./dist/stubs/index.d.mts",
      "import": "./dist/stubs/index.mjs"
    },
    "#nitro-graphql/graphql-config": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-schemas": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-resolvers": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/server-directives": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/module-config": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/debug-info": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    },
    "#nitro-graphql/pubsub": {
      "types": "./dist/nitro/virtual/stubs.d.mts",
      "import": "./dist/nitro/virtual/stubs.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./native": {
      "types": "./native/index.d.ts",
      "import": "./native/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.mts",
      "import": "./dist/cli/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./define": {
      "types": "./dist/define.d.mts",
      "import": "./dist/define.mjs"
    },
    "./apollo": {
      "types": "./dist/nitro/apollo.d.mts",
      "import": "./dist/nitro/apollo.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs"
    },
    "./pubsub": {
      "types": "./dist/core/pubsub/index.d.mts",
      "import": "./dist/core/pubsub/index.mjs"
    },
    "./subscribe": {
      "types": "./dist/subscribe/index.d.mts",
      "import": "./dist/subscribe/index.mjs"
    },
    "./nitro/routes/graphql-yoga": {
      "types": "./dist/nitro/routes/graphql-yoga.d.mts",
      "import": "./dist/nitro/routes/graphql-yoga.mjs"
    },
    "./nitro/routes/graphql-yoga-ws": {
      "types": "./dist/nitro/routes/graphql-yoga-ws.d.mts",
      "import": "./dist/nitro/routes/graphql-yoga-ws.mjs"
    },
    "./nitro/routes/apollo-server": {
      "types": "./dist/nitro/routes/apollo-server.d.mts",
      "import": "./dist/nitro/routes/apollo-server.mjs"
    },
    "./nitro/routes/apollo-server-ws": {
      "types": "./dist/nitro/routes/apollo-server-ws.d.mts",
      "import": "./dist/nitro/routes/apollo-server-ws.mjs"
    },
    "./nitro/routes/apollo-sandbox-script": {
      "types": "./dist/nitro/routes/apollo-sandbox-script.d.mts",
      "import": "./dist/nitro/routes/apollo-sandbox-script.mjs"
    },
    "./nitro/routes/health": {
      "types": "./dist/nitro/routes/health.d.mts",
      "import": "./dist/nitro/routes/health.mjs"
    },
    "./nitro/routes/debug": {
      "types": "./dist/nitro/routes/debug.d.mts",
      "import": "./dist/nitro/routes/debug.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "nitro-graphql": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "native/index.d.ts",
    "native/index.js"
  ],
  "napi": {
    "binaryName": "graphql-lint",
    "packageName": "nitro-graphql",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "pnpm build:native && tsdown",
    "build:native": "cd native && napi build --platform --release --esm",
    "dev": "tsdown --watch",
    "bumpp": "bumpp package.json native/package.json native/npm/*/package.json",
    "release": "pnpm build && pnpm bumpp",
    "playground:nitro": "cd playgrounds/nitro && pnpm install && pnpm dev",
    "playground:nuxt": "cd playgrounds/nuxt && pnpm install && pnpm dev",
    "playground:federation": "cd playgrounds/federation && pnpm install && pnpm dev",
    "playground:subscriptions": "cd playgrounds/subscriptions && pnpm install && pnpm dev",
    "docs:dev": "cd .docs && pnpm install && pnpm update:metadata && pnpm dev",
    "docs:build": "cd .docs && pnpm install && pnpm update:metadata && pnpm build",
    "docs:preview": "cd .docs && pnpm preview",
    "cli": "node ./dist/cli/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:tscheck": "tsgo --noEmit"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "crossws": "^0.4.4",
    "graphql": "^16.12.0",
    "graphql-sse": "^2.6.0",
    "graphql-ws": "^6.0.6",
    "nitro": "^3.0.260311-beta"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "crossws": {
      "optional": true
    },
    "graphql-sse": {
      "optional": true
    },
    "graphql-ws": {
      "optional": true
    }
  },
  "dependencies": {
    "@apollo/subgraph": "catalog:",
    "@bomb.sh/tab": "catalog:",
    "@graphql-codegen/core": "catalog:",
    "@graphql-codegen/import-types-preset": "catalog:",
    "@graphql-codegen/typed-document-node": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-resolvers": "catalog:",
    "@graphql-tools/graphql-file-loader": "catalog:",
    "@graphql-tools/load": "catalog:",
    "@graphql-tools/load-files": "catalog:",
    "@graphql-tools/merge": "catalog:",
    "@graphql-tools/schema": "catalog:",
    "@graphql-tools/url-loader": "catalog:",
    "@graphql-tools/utils": "catalog:",
    "c12": "catalog:",
    "chokidar": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "giget": "catalog:",
    "graphql-config": "catalog:",
    "graphql-scalars": "catalog:",
    "knitwork": "catalog:",
    "mlly": "catalog:",
    "ofetch": "catalog:",
    "ohash": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "perfect-debounce": "catalog:",
    "srvx": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "bumpp": "catalog:",
    "changelogen": "catalog:",
    "crossws": "catalog:",
    "eslint": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "nitro": "catalog:",
    "nuxt": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  },
  "overrides": {
    "graphql": "^16.13.1",
    "nitro": "^3.0.260311-beta",
    "vue-router": "^5.0.3"
  },
  "resolutions": {
    "graphql": "^16.13.1",
    "nitro": "^3.0.260311-beta",
    "nitro-graphql": "link:.",
    "vue-router": "^5.0.3"
  }
}
