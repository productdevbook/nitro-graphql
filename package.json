{
  "name": "nitro-graphql-yoga",
  "type": "module",
  "version": "0.1.0",
  "description": "GraphQL Yoga integration for Nitro",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
