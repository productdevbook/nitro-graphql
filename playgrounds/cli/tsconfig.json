{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#graphql/server": ["./.graphql/types/nitro-graphql-server.d.ts"],
      "#graphql/client": ["./.graphql/types/nitro-graphql-client.d.ts"],
      "#graphql/schema": ["./server/graphql/schema.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".graphql"]
}
